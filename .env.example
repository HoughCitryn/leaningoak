# Copy this file to .env.local and fill in your provider's credentials.
# SMTP takes precedence when SMTP_HOST is set. Leave it blank to use Resend.
SMTP_HOST="send.smtp.com"
SMTP_PORT=587
# false = STARTTLS (usually 587); true = implicit TLS (usually 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_API=
# Use a sender address authorized by your email provider.
SMTP_FROM_EMAIL="Leaning Oak Ranch <inquiries@leaningoakranch.com>"
CONTACT_TO_EMAIL=barbara@leaningoakranch.com


# Both Turnstile keys are required for contact-form submissions.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# GA4 measurement ID from the existing Leaning Oak Ranch web stream.
# Set before the production build. Analytics requires visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-JCNF32VN9M
# Preserve the existing public verification token from the live website.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=_bqJtc4lTjMiE4ROC2772A50ODWUuiZFbFHzQlLW40A
